{
  "schema_version": "genguard.edge.profile/1",
  "profile_id": "marine-engine-public-v1",
  "asset_id": "MATSUI-MU323DGSC-RESEARCH",
  "data_domain": "public_replay",
  "description": "실제 선박용 디젤엔진 시험대의 제어계측 데이터 재생. 군 비상발전기/IMU 통합 실측 모델이 아님.",
  "phases": ["running"],
  "context": ["load_pct", "ambient_c"],
